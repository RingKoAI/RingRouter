# RingRouter 环境配置模板
# 复制为 .env 并按需修改（docker compose 会自动读取）

# ── 服务器 ──────────────────────────────────────────────
PORT=3000

# ── 数据库（默认 postgres，支持 mysql / sqlite）────────────
DB_TYPE=postgres
# postgres / mysql 使用 DSN
DB_DSN=postgres://ringrouter:ringrouter@postgres:5432/ringrouter?sslmode=disable
# sqlite 轻量模式（不推荐生产）
# DB_TYPE=sqlite
# DB_PATH=data/ringrouter.db

# ── Redis（可选共享缓存；不设即禁用，one-api 语义）─────────
# 连接串形式（推荐，设置即启用）
REDIS_CONN_STRING=redis://redis:6379
# 带密码/库号：redis://:password@redis:6379/0
# 或分离变量（REDIS_ENABLED 显式开关）
# REDIS_ENABLED=true
# REDIS_ADDR=redis:6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ── 认证 ────────────────────────────────────────────────
# 管理密钥（API 调用认证 / 引导会话）。留空则随机生成。
ADMIN_KEY=ringrouter-admin-key
# 密钥加密盐（AES-GCM）。务必设置为随机长字符串！
JWT_SECRET=change-me-to-a-long-random-string

# ── Cloudflare Turnstile（可选人机验证）───────────────────
# TURNSTILE_SITEKEY=1x00000000000000000000AA
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# ── docker compose 专用（服务名固定）──────────────────────
POSTGRES_USER=ringrouter
POSTGRES_PASSWORD=ringrouter
POSTGRES_DB=ringrouter
POSTGRES_PORT=5432
REDIS_PASSWORD=
TZ=Asia/Singapore