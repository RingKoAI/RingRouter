# RingRouter Configuration
# Copy to .env and adjust values

# Server
PORT=3000
GIN_MODE=release

# Database
DB_TYPE=sqlite
DB_PATH=data/ringrouter.db
# DB_TYPE=mysql
# DB_DSN=user:password@tcp(127.0.0.1:3306)/ringrouter?charset=utf8mb4&parseTime=True&loc=Local
# DB_TYPE=postgres
# DB_DSN=host=127.0.0.1 user=postgres password=postgres dbname=ringrouter port=5432 sslmode=disable

# Redis (optional)
# REDIS_ENABLED=true
# REDIS_ADDR=127.0.0.1:6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Auth
JWT_SECRET=change-me-to-a-random-string
ADMIN_KEY=ringrouter-admin-key

# Default upstream provider
DEFAULT_PROVIDER=openai
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1

# Logging
LOG_LEVEL=info